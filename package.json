{
  "name": "macbook-cleaner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run web:dev",
    "build": "npm run web:build",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:build:release": "npm --prefix web run build:release",
    "web:preview": "npm --prefix web run preview",
    "web:typecheck": "npm --prefix web run typecheck",
    "desktop:preview": "vite",
    "desktop:build": "tsc -b && vite build",
    "desktop:preview:serve": "vite preview",
    "lint": "oxlint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dmg:native": "node scripts/build-dmg.mjs native",
    "dmg:arm64": "node scripts/build-dmg.mjs arm64",
    "dmg:intel": "node scripts/build-dmg.mjs intel",
    "dmg:universal": "node scripts/build-dmg.mjs universal",
    "dmg:production": "node scripts/build-dmg.mjs native --production",
    "icons": "node scripts/render-icon.mjs && tauri icon src-tauri/icons/source/icon-1024.png",
    "test:native": "node scripts/run-cargo.mjs test"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
