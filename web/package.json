{
  "name": "macbook-cleaner-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-installer.mjs build && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:release": "REQUIRE_INSTALLER=1 npm run build && node scripts/verify-download.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "node scripts/prepare-installer.mjs dev && tsc -b",
    "verify:download": "node scripts/verify-download.mjs",
    "og": "node scripts/render-og.mjs",
    "predev": "node scripts/prepare-installer.mjs dev"
  },
  "dependencies": {
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
