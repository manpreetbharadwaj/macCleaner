{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MacBook Cleaner",
  "version": "1.0.0",
  "identifier": "com.macbookcleaner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MacBook Cleaner",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources": "gen/lproj"
      }
    },
    "category": "Utility",
    "shortDescription": "Clean your Mac. Keep what matters."
  }
}
