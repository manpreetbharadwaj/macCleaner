# Copy to .env.production (or set in your hosting provider) and fill in.
# All values are read at build time — rebuild after changing them.

# Public URL of the site, no trailing slash. Used for canonical URLs, Open Graph, sitemap.xml.
VITE_SITE_URL=https://macbookcleaner.app

# Download link for the Mac installer. Usually leave this EMPTY: the build
# (scripts/prepare-installer.mjs) finds the DMG for the current app version in
# src-tauri/target/release/bundle/dmg/, verifies it, and serves it from this
# site at /downloads/. Set it only to host the DMG elsewhere, for example:
# https://github.com/<owner>/<repo>/releases/download/v1.0.0/MacBook-Cleaner-1.0.0-apple-silicon.dmg
VITE_MAC_DOWNLOAD_URL=

# Optional public release date shown on the Download page and Release Notes.
VITE_RELEASE_DATE=

# Contact addresses shown on Support, Privacy and Terms.
VITE_SUPPORT_EMAIL=support@macbookcleaner.app
VITE_PRIVACY_EMAIL=privacy@macbookcleaner.app
